{
  "name": "@tetherto/pear-wrk-wdk",
  "version": "1.0.0-beta.15",
  "main": "index.js",
  "scripts": {
    "build:types": "tsc --noEmit",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "gen:hrpc": "node scripts/generate-hrpc.js",
    "gen:schema": "npm run gen:hrpc",
    "prepare": "npm run gen:hrpc"
  },
  "files": [
    "index.js",
    "worklet.js",
    "jsonrpc.js",
    "src",
    "types",
    "generated",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@scure/bip39": "^2.2.0",
    "hrpc": "^4.0.1",
    "hyperschema": "^1.12.4"
  },
  "optionalDependencies": {
    "bare-walk-handles": "^2.1.0"
  },
  "devDependencies": {
    "bare-ipc": "^1.1.1",
    "rimraf": "6.0.1",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./worklet": {
      "types": "./types/index.d.ts",
      "default": "./worklet.js"
    },
    "./diagnostics/handle-leak-check": {
      "types": "./types/diagnostics/handle-leak-check.d.ts",
      "default": "./src/diagnostics/handle-leak-check.js"
    },
    "./jsonrpc": {
      "types": "./types/jsonrpc.d.ts",
      "default": "./jsonrpc.js"
    },
    "./package.json": "./package.json",
    "./hrpc": {
      "types": "./types/hrpc/hrpc.d.ts",
      "default": "./generated/hrpc/index.js"
    }
  },
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/tetherto/pear-wrk-wdk.git"
  }
}
